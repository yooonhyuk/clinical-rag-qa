# --- Database ---
DATABASE_URL=postgresql+asyncpg://clinical:clinical@db:5432/clinical_rag_qa

# --- Ollama (local only; no external LLM API) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=gemma4:e4b
# --- Embedding model ---
# bge-m3(기본, 다국어, 1024차원, task prefix 없음). nomic-embed-text(768차원)는 한글을 [UNK]로
# 처리하므로 한국어 문서에 쓰지 않는다(docs/issues/001-korean-embedding-unk.md).
# 모델을 바꾸면 기존 벡터와 비교할 수 없다. 차원이 다르면 `make reset-embeddings` 후 재인덱싱,
# 차원이 같아도 재인덱싱(/api/index)이 다른 모델의 문서를 다시 embedding한다.
OLLAMA_EMBEDDING_MODEL=bge-m3
# 비우면 알려진 모델의 차원을 쓴다(bge-m3 1024, nomic-embed-text 768). 그 외 모델은 필수.
EMBEDDING_DIM=
# 지정하지 않으면 모델 기본값(nomic: "search_query: "/"search_document: ", bge-m3: 없음)
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=
OLLAMA_TIMEOUT_SEC=60
OLLAMA_MAX_RETRIES=3

# --- Generation provider (embeddings always stay on local Ollama) ---
# ollama (default, local-first) | anthropic (opt-in, sample/non-sensitive corpus only)
LLM_PROVIDER=ollama
# anthropic 모드는 아래 3가지가 모두 필요하다. 하나라도 없으면 앱이 시작되지 않는다.
#   1) ALLOW_EXTERNAL_LLM=true
#   2) RAW_DOCS_PATH/.corpus.yaml 에 classification: synthetic-sample | non-sensitive |
#      public-regulatory. licensed-local-only(저작권 문서)·confidential·표식 없음은 로컬 전용:
#      anthropic 모드에서 검색 대상에서 빠지고, 그 코퍼스로 제한한 질문은 403으로 거부된다.
#   3) ANTHROPIC_API_KEY (환경변수로만 주입. 실제 키를 이 파일이나 저장소에 커밋하지 말 것)
ALLOW_EXTERNAL_LLM=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_TIMEOUT_SEC=60
ANTHROPIC_MAX_RETRIES=3

# --- Concurrency ---
PARSE_CONCURRENCY=2
EMBED_CONCURRENCY=4
EMBED_BATCH_SIZE=16

# --- Retrieval / RAG ---
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# cosine similarity 하한. top-1 score가 이 값보다 낮으면 LLM을 호출하지 않고 거절한다.
MIN_RELEVANCE_SCORE=0.45
# pgvector + pg_trgm(RRF) 하이브리드 검색. bge-m3에서는 평가셋 기준 이득이 없어 기본 off
# (docs/issues/001-korean-embedding-unk.md). 한국어 어휘가 없는 embedding 모델을 쓸 때만 켠다.
HYBRID_SEARCH=false
RRF_K=60
# hnsw(기본, 근사) | exact(인덱스를 끄고 정확한 cosine 순서, 느리지만 DB 내용과 무관하게 재현됨)
# docs/issues/009: HNSW는 ef_search(기본 40)개 후보를 고른 뒤 코퍼스 필터를 건다.
VECTOR_SEARCH=hnsw
# pgvector 0.8 iterative index scan: off | relaxed_order | strict_order
HNSW_ITERATIVE_SCAN=off
# HNSW 후보 수(pgvector 기본 40). 비우면 기본값. 클수록 exact에 가깝고 느리다.
HNSW_EF_SEARCH=
# cross-encoder reranker (선택, B7). `uv sync --project backend --extra rerank`와 로컬 HF 캐시의
# BAAI/bge-reranker-v2-m3(고정 revision) 또는 RERANKER_MODEL=<폴더>가 필요하다. 런타임에 받지 않는다.
# RERANK_CANDIDATES개를 cosine으로 가져와 cross-encoder 점수로 TOP_K개를 고르고,
# 최고 점수가 RERANK_MIN_SCORE보다 낮으면 NO_EVIDENCE로 거절한다. 기본 api 이미지에는 없다.
RERANKER=none
RERANK_CANDIDATES=30
RERANK_MIN_SCORE=0.0
RERANKER_DEVICE=auto
# 모델이 근거 부족으로 표시했지만 근거를 인용한 답변을 "부분 답변"(caveat 포함)으로 돌려준다.
# false면 MVP-1처럼 거절(MODEL_REFUSED)한다. docs/issues/007
PARTIAL_ANSWERS=true

# --- Paths ---
RAW_DOCS_PATH=./data/raw-docs/documents
DICOM_PATH=./data/raw-docs/dicom
SAMPLES_PATH=./samples
# Repo corpora (corpus/public: public regulatory docs). /api/index {"path": "corpus/public"}
CORPORA_PATH=./corpus
RULES_PATH=./backend/app/rules

# --- LOCAL-ONLY private corpus (선택) ---
# 저장소 밖 폴더(예: ~/clinical-rag-private, .corpus.yaml classification: licensed-local-only).
# /api/index가 읽을 수 있는 폴더에 추가된다. compose에서는 docker-compose.private.yml이
# 읽기 전용으로 /private-corpus에 마운트하고 이 값을 설정한다(make up-private).
PRIVATE_CORPUS_PATH=
